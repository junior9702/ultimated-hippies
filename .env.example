# PAYHERO SERVER SECRETS
# Put the real values ONLY in your Netlify Site > Project configuration > Environment variables.
# NEVER paste real values into index.html or frontend JavaScript.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_ACCOUNT_ID=
PAYHERO_CALLBACK_URL=
PAYHERO_BASE_URL=https://api.payhero.africa

# FIREBASE ADMIN SERVER SECRETS
# Use either FIREBASE_SERVICE_ACCOUNT_JSON
# OR the three variables below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
